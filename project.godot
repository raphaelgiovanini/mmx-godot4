; Engine configuration file.
config_version=5

[application]

config/name="Mega Man X + X2 (Godot 4)"
run/main_scene="res://scenes/stages/highway.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=398
window/size/viewport_height=224
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=1

[rendering]

anti_aliasing/quality/msaa_2d=2

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[autoload]

Controls="*res://scripts/controls.gd"
